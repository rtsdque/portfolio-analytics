# Copy to .env and fill in. .env is gitignored; this file is not.

# Alpaca — free at alpaca.markets. A paper-trading account is enough for
# market data; no funding or live trading required.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Alpaca data feed. "sip" is full-market consolidated tape and is available on
# the free Basic plan for data older than 15 minutes, which covers all daily
# bars. "iex" is real-time but only ~2-3% of volume, so thin names get gappy
# bars. The client falls back to iex automatically on a subscription error.
ALPACA_FEED=sip

# SEC EDGAR requires a User-Agent identifying you, with a real contact address.
# Requests without one get a 403. Format: "Name contact@example.com"
# Put your own email here — do not commit a real address in .env.example.
SEC_USER_AGENT=Your Name your.email@example.com

# Cache store. SQLite is fine locally; set a postgresql:// URL in production.
DATABASE_URL=sqlite:///./cache.db

# Annual risk-free rate used for Sharpe/Sortino/Merton defaults.
RISK_FREE_RATE=0.045
